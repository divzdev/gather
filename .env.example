# Copy to .env — `make setup` does this for you.
# Every value below is a working local default. No credentials are required to
# run this project; that is deliberate and enforced by tests.

ENV=local
DEMO_MODE=true

# --- Local infrastructure -----------------------------------------------------
# Ports are fixed in docker-compose.yml at the repo root: Postgres 5441, Redis 6379.
DATABASE_URL=postgresql+asyncpg://gather:gather@localhost:5441/gather
REDIS_URL=redis://localhost:6379/0

# --- API ----------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8051

# The web app reads its own apps/web/.env.local (Next does not read this file).
# It defaults to http://127.0.0.1:8051/v1 in code, so no file is needed locally.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8051/v1
# Signs access tokens. Local-only value; production reads this from SSM.
SECRET_KEY=dev-secret-not-for-production-do-not-reuse
CORS_ORIGINS=http://localhost:3000,http://localhost:8842,http://gather.localhost:8842,http://127.0.0.1:3000

# --- Mail ---------------------------------------------------------------------
# `log` writes rendered emails to .mail/ as .html and sends nothing.
MAIL_TRANSPORT=log
MAIL_FROM=events@example.com

# --- AI -----------------------------------------------------------------------
# Leave empty to use the stub adapter. AI surfaces then show an info note
# instead of failing, and the app remains fully usable.
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5
AI_MAX_TOKENS=4096

# --- Storage ------------------------------------------------------------------
# `local` writes uploads to .uploads/ and serves them directly. No AWS needed.
STORAGE_BACKEND=local
S3_BUCKET=
AWS_REGION=us-east-1
